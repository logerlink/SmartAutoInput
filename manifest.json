{
  "name": "__MSG_ext_name__",
  "description": "__MSG_ext_description__",
  "default_locale": "zh_CN", 
  "manifest_version": 3,
  "version": "1.0.0",
  
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus"
  ],
  
  "options_page": "settings.html",
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils.js", "commonUtils.js", "advancedMockData.js", "settingsManager.js", "dynamic_mode_switch.js", "content.js"],
      "css": ["styles.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "智能表单数据模拟助手"
  },
  
  "web_accessible_resources": [
    {
      "resources": ["settings.html", "settings.js"],
      "matches": ["<all_urls>"]
    }
  ]
}